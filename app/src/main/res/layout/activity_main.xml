<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- SECTION 1: WI-FI -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Wi-Fi Configuration"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#2196F3"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnReadWifi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Read Wi-Fi MAC" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvWifiResult"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="WiFi Mac:\n "
                android:textSize="14sp"
                android:background="#10000000"
                android:padding="10dp"
                android:fontFamily="monospace" />

            <Button
                android:id="@+id/btnCopyWifi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Copy"
                android:enabled="false"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etWifiMac"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="4"
                android:hint="New MAC"
                android:fontFamily="monospace"
                android:textSize="14sp"
                android:maxLength="17"
                android:inputType="textCapCharacters" />

            <Button
                android:id="@+id/btnGenerateWifi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="GEN"
                android:layout_marginStart="4dp" />

            <Button
                android:id="@+id/btnWriteWifi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:minWidth="0dp"
                android:text="Write"
                android:enabled="false"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/cbGenOnReset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Auto-generate on reset"
            android:layout_marginTop="6dp" />

        <!-- DIVIDER -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#D3D3D3"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp" />

        <!-- SECTION 2: BLUETOOTH -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bluetooth Configuration"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#4CAF50"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnReadBt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Read Bluetooth MAC" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvBtResult"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Bluetooth Mac:\n "
                android:textSize="14sp"
                android:background="#10000000"
                android:padding="10dp"
                android:fontFamily="monospace" />

            <Button
                android:id="@+id/btnCopyBt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Copy"
                android:enabled="false"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etBtMac"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="4"
                android:hint="New MAC"
                android:fontFamily="monospace"
                android:textSize="14sp"
                android:maxLength="17"
                android:inputType="textCapCharacters" />

            <Button
                android:id="@+id/btnGenerateBt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="GEN"
                android:layout_marginStart="4dp" />

            <Button
                android:id="@+id/btnWriteBt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:minWidth="0dp"
                android:text="Write"
                android:enabled="false"
                android:layout_marginStart="4dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
